# Mimmo Fratelli E-commerce Platform
# Environment Variables Configuration
# Copy this file to .env and fill in your values

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your-key-here
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
# Required only when one webhook URL intentionally receives both modes.
STRIPE_SECRET_KEY_TEST=sk_test_your-test-key-here
STRIPE_SECRET_KEY_LIVE=sk_live_your-live-key-here
STRIPE_WEBHOOK_SECRET_TEST=whsec_your-test-endpoint-secret
STRIPE_WEBHOOK_SECRET_LIVE=whsec_your-live-endpoint-secret
# Enable only in an isolated staging/development database.
STRIPE_ALLOW_TEST_MODE=false
# Hold stock/internal value while a delayed payment is processing (1-336 hours).
STRIPE_ASYNC_RESERVATION_HOURS=168
# Optional Stripe Payment Method Configuration dedicated to stored-value sales.
STRIPE_GIFTCARD_PAYMENT_METHOD_CONFIGURATION=pmc_your-configuration-id

# PayPal Configuration
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret

# Klarna Configuration
KLARNA_API_KEY=your-klarna-api-key
KLARNA_API_SECRET=your-klarna-api-secret

# Courier API Configuration (BRT, DHL, GLS)
COURIER_PROVIDER=BRT
COURIER_API_KEY=your-courier-api-key
COURIER_API_SECRET=your-courier-api-secret

# Email Service Configuration
EMAIL_SERVICE_API_KEY=your-email-service-key
EMAIL_FROM_ADDRESS=noreply@mimmofratelli.com

# Google Wallet Configuration (PRODUZIONE ATTIVA)
# Console: https://pay.google.com/business/console/home/BCR2DN5TRCL3D3SZ
GOOGLE_WALLET_ISSUER_ID=3388000000023043592
GOOGLE_WALLET_SERVICE_ACCOUNT_EMAIL=wallet@your-project.iam.gserviceaccount.com
GOOGLE_WALLET_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----"

# Apple Wallet Configuration (opzionale)
APPLE_PASS_TYPE_ID=pass.com.mimmofratelli.giftcard
APPLE_TEAM_ID=YOUR_TEAM_ID
